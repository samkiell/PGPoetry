# --- Database ---
# MongoDB connection string (Atlas or local).
MONGODB_URI="mongodb+srv://user:password@cluster.mongodb.net/pgpoetry?retryWrites=true&w=majority"

# --- Auth.js (NextAuth v5) ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-string"


# The email address that should be granted the admin role on sign-up.
ADMIN_EMAIL="you@example.com"

# --- Cloudinary (image uploads) ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Email (Resend) ---
# API key from https://resend.com/api-keys. If unset, email features are
# disabled and codes/links are logged to the server console in development.
RESEND_API_KEY=""
# Verified sender. Until you verify a domain in Resend, leave the default,
# which only delivers to the email you signed up to Resend with.
EMAIL_FROM="PGpoetry <onboarding@resend.dev>"

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="PGpoetry"
